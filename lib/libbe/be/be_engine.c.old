static struct be_window *be_window_on_attach(struct be_engine *be)
{
    struct be_window *win = be_alloc_perm(be, sizeof(*win), 1);

    struct be_layer *window_settings = be_get_layer_by_name("window_settings");
    ASSERT(win_settings, "Client must provide a "STR_QUOT("window_settings")" layer!");

    /* copy the window settings and cleanup the layer */
    struct wm_window_info main_window_info = *window_settings->context;
    be_detach_layer_by_name(be, "window_settings");

    wm_init(&win->wm);
    wm_window_create(&win->wm, &win->main_window, main_window_info);

    return win;
}

static void be_window_on_detach(struct be_engine *be, struct be_window *win)
{
    be_detach_layer_by_name(be, "be_input");

    wm_window_close(&win->wm, &win->main_window);
    wm_shutdown(&win->wm);
}

static void be_window_on_update(struct be_engine *be, struct be_window *win)
{
    UNUSED(be);
    UNUSED(win);
}

static void be_window_on_event(struct be_engine *be, struct be_window *win, struct wm_event event)
{
    UNUSED(be);
    UNUSED(event);
    UNUSED(win);
}
