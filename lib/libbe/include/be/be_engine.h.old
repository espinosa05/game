#ifndef __BE_BE_ENGINE_H__
#define __BE_BE_ENGINE_H__

#include <core/wm.h>
#include <core/os.h>
#include <be/be_arena.h>
#include <core/memory_macros.h>
#include <be/be_app_entry.h>

struct be_layers {
    MM_ARRAY_MEMBERS(struct be_layer);
};

struct be_frame_time {
    struct os_time start;
    struct os_time end;
};

struct be_engine {
    b32 run;
    f64 delta;
    struct be_frame_time frame_time;

    struct be_arena transient;
    struct be_arena permanent;
    struct be_layers layers;
};
